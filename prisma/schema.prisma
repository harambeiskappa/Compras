// Esquema de los módulos 1 (información de la compra) y 2 (compra).
// Reglas duras del dominio en CLAUDE.md. Sin dato es NULL y se muestra «s/d»:
// no hay DEFAULT 0 en ninguna columna de cantidad, peso, precio o monto, y cada
// NOT NULL tiene su justificación escrita al lado.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// La URL de conexión NO va acá: en Prisma 7 `datasource.url` dejó de admitirse
// en el schema. Son DOS conexiones distintas, las dos inyectadas por la
// integración de Supabase (no existe DATABASE_URL en este proyecto):
//
//   - CLI / migraciones -> POSTGRES_URL_NON_POOLING (directa), en
//     `prisma.config.ts`. pgbouncer rompe los locks y prepared statements
//     de migrate.
//   - App en runtime -> la pooleada (POSTGRES_PRISMA_URL / POSTGRES_URL), vía
//     `new PrismaClient({ adapter })`. Sin pool, en serverless se agotan las
//     conexiones.
datasource db {
  provider = "postgresql"
}

// ---------- Catálogos ----------

model Empresa {
  id       Int      @id @default(autoincrement())
  nombre   String
  // Nullable a propósito: DECIDIR #10 (TRB propio o tercero) sigue sin resolver.
  // Si fuera NOT NULL, el seed estaría obligado a inventar una respuesta.
  esPropio Boolean?
  activo   Boolean  @default(true)

  prefijos           PrefijoTropa[]
  // «donde esta empresa figura como titular», no «las compras de esta empresa»:
  // las cabezas pueden quedar en otra. Ver la nota sobre titular vs. compradora.
  comprasComoTitular Compra[]
  tropas             Tropa[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("empresa")
}

// Un mismo comprador puede tener más de un prefijo de tropa (por eso 1:N y no
// una columna suelta en Empresa). Ver DECIDIR #10 sobre qué nombres van acá.
model PrefijoTropa {
  id        Int     @id @default(autoincrement())
  codigo    String  @unique // ej. "PEG", "TAP", "LTA"
  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  @@map("prefijo_tropa")
}

model Consignatario {
  id                Int     @id @default(autoincrement())
  // `nombre` guarda el texto tal como se escribió; `nombreNormalizado`
  // (trim + minúsculas + vocales sin acento, ver src/lib/normalizar.ts) lleva
  // el @unique. Mismo patrón que CategoriaSinonimo, y por el mismo motivo:
  // este catálogo se crea al vuelo desde un buscador del formulario, donde
  // tipear un nombre nuevo es un clic, y sin esto nada impide dos filas para
  // la misma entidad. Quien busque o inserte tiene que normalizar ANTES.
  nombre            String
  nombreNormalizado String  @unique
  activo            Boolean @default(true)

  compras Compra[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("consignatario")
}

model Vendedor {
  id                Int     @id @default(autoincrement())
  // `nombre` guarda el texto tal como se escribió; `nombreNormalizado`
  // (trim + minúsculas + vocales sin acento, ver src/lib/normalizar.ts) lleva
  // el @unique. Mismo patrón que CategoriaSinonimo, y por el mismo motivo:
  // este catálogo se crea al vuelo desde un buscador del formulario, donde
  // tipear un nombre nuevo es un clic, y sin esto nada impide dos filas para
  // la misma entidad. Quien busque o inserte tiene que normalizar ANTES.
  nombre            String
  nombreNormalizado String  @unique
  activo            Boolean @default(true)

  compras Compra[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("vendedor")
}

model Hotelero {
  id                Int     @id @default(autoincrement())
  // `nombre` guarda el texto tal como se escribió; `nombreNormalizado`
  // (trim + minúsculas + vocales sin acento, ver src/lib/normalizar.ts) lleva
  // el @unique. Mismo patrón que CategoriaSinonimo, y por el mismo motivo:
  // este catálogo se crea al vuelo desde un buscador del formulario, donde
  // tipear un nombre nuevo es un clic, y sin esto nada impide dos filas para
  // la misma entidad. Quien busque o inserte tiene que normalizar ANTES.
  nombre            String
  nombreNormalizado String  @unique
  activo            Boolean @default(true)

  compras Compra[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("hotelero")
}

// Sin precedente histórico: no existe en ningún lado del sistema viejo.
model PersonaCompradora {
  id                Int     @id @default(autoincrement())
  // `nombre` guarda el texto tal como se escribió; `nombreNormalizado`
  // (trim + minúsculas + vocales sin acento, ver src/lib/normalizar.ts) lleva
  // el @unique. Mismo patrón que CategoriaSinonimo, y por el mismo motivo:
  // este catálogo se crea al vuelo desde un buscador del formulario, donde
  // tipear un nombre nuevo es un clic, y sin esto nada impide dos filas para
  // la misma entidad. Quien busque o inserte tiene que normalizar ANTES.
  nombre            String
  nombreNormalizado String  @unique
  activo            Boolean @default(true)

  compras Compra[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("persona_compradora")
}

// Las 8 canónicas: NV, NT, VQ, VA, TO, TM, TH, T.
model Categoria {
  id          Int    @id @default(autoincrement())
  codigo      String @unique
  descripcion String

  sinonimos CategoriaSinonimo[]

  @@map("categoria")
}

// `texto` guarda el string tal cual vino de la fuente (ej. "MEJ", " Mej ") —
// es el dato crudo y no se toca. `textoNormalizado` es ese mismo string con
// trim + minúsculas, y es el que lleva el @unique: así "mej", "MEJ" y "Mej"
// colapsan en UNA fila sin necesidad de la extensión citext de Postgres.
// Consecuencia para el seed: los 258 sinónimos históricos entran deduplicados
// por `textoNormalizado`, no uno por cada variante de may/min o espacios.
// Quien escriba el importador debe normalizar ANTES de insertar o buscar.
//
// categoriaCanonicaId NULL = pendiente de mapeo: no se adivina, lo resuelve una
// persona. El Lote se guarda igual, completo; lo único que queda pendiente es
// la resolución del mapeo canónico.
model CategoriaSinonimo {
  id                  Int        @id @default(autoincrement())
  texto               String
  textoNormalizado    String     @unique
  categoriaCanonicaId Int?
  categoriaCanonica   Categoria? @relation(fields: [categoriaCanonicaId], references: [id])

  lotes Lote[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("categoria_sinonimo")
}

// ---------- Dominio de la compra (módulos 1 y 2) ----------

// `Compra.empresaTitularId` y `Tropa.empresaCompradoraId` NO son el mismo dato:
// la titular es bajo qué empresa se registra la compra, la de la tropa es a
// quién le quedan las cabezas. Lo normal es una sola empresa por compra; la
// excepción es una empresa que compró poco y se cuelga de la compra de otra.
//
// AVISO, no bloqueo: al cerrar el módulo 2, si la empresa titular no aparece
// entre las empresas de las tropas, la app lo señala y una persona decide.
// No lo impide.
//
// Por qué no bloquea: la empresa puede cambiar legítimamente entre la compra y
// la liquidación — se define comprar para BUL y se termina liquidando a PEGSA,
// que están muy vinculadas. Bloquearlo impediría un caso real. En el histórico
// hay 9 compras así (ver docs/prueba-historico-modulos-1-2.md), y no son datos
// mal cargados. Misma forma que los kilos faltantes: señalar, no bloquear.
//
// Tampoco podría ser un constraint de base aunque se quisiera: en el módulo 1
// todavía no hay ninguna tropa contra la cual chequear.
//
// En el formulario, la empresa de cada tropa viene precargada con la titular.

model Compra {
  id    Int      @id @default(autoincrement())
  fecha DateTime @db.Date

  // NOT NULL a propósito: el consignatario SIEMPRE existe, también en la compra
  // directa — no es sinónimo de feria.
  //
  // Para cuando se hagan las pantallas: este campo NO se puede rotular «Feria».
  // Quien compra directo lo leería como que no le corresponde y lo dejaría
  // vacío, que es justo el agujero que se está tapando. En el histórico hay 14
  // compras sin consignatario (ver docs/prueba-historico-modulos-1-2.md).
  consignatarioId Int
  consignatario   Consignatario @relation(fields: [consignatarioId], references: [id])

  // Bajo qué empresa se registra la compra; dato del módulo 1, antes de que
  // exista ninguna tropa.
  empresaTitularId Int
  empresaTitular   Empresa @relation(fields: [empresaTitularId], references: [id])

  vendedorId Int?
  vendedor   Vendedor? @relation(fields: [vendedorId], references: [id])

  hoteleroId Int?
  hotelero   Hotelero? @relation(fields: [hoteleroId], references: [id])

  personaCompradoraId Int?
  personaCompradora   PersonaCompradora? @relation(fields: [personaCompradoraId], references: [id])

  plazaLugar String?

  // La comisión NO vive acá: se aplica por renglón, no por compra. Está en
  // `Lote.comision` — ver la nota ahí sobre por qué el total no se guarda.
  observaciones String?

  tropas   Tropa[]
  cargas   Carga[]
  lotes    Lote[]
  adjuntos Adjunto[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("compra")
}

// Nullable en nroTropa/fecha: los genera WinCampo y pueden no conocerse cuando
// el comprador carga desde la feria (cobertura histórica de nro_tropa: 5,1%).
// nroTropa lleva @unique replicando el UNIQUE que tenía ingresos_tropa; al ser
// nullable, Postgres deja convivir varios NULL bajo un índice único, así que la
// restricción aplica solo a los números ya conocidos, que es lo que se quiere.
model Tropa {
  id       Int    @id @default(autoincrement())
  compraId Int
  compra   Compra @relation(fields: [compraId], references: [id])

  // A quién le quedan efectivamente estas cabezas; casi siempre es la titular
  // de la compra, la excepción es una empresa que compró poco y se cuelga.
  empresaCompradoraId Int
  empresaCompradora   Empresa @relation(fields: [empresaCompradoraId], references: [id])

  nroTropa String?   @unique
  fecha    DateTime? @db.Date

  cargas Carga[]
  lotes  Lote[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Sostiene la FK compuesta de Lote y Carga: sin este unique, Postgres no
  // acepta (id, compraId) como destino de una foreign key.
  @@unique([id, compraId])
  @@map("tropa")
}

// DECIDIR #7 (carga↔tropa): lo cierro como N:1 (una carga pertenece a lo sumo
// una tropa; una tropa puede tener varias cargas), con tropaId NULLABLE porque
// la tropa muchas veces todavía no se conoce cuando se carga el camión en la
// feria.
model Carga {
  id       Int    @id @default(autoincrement())
  compraId Int
  compra   Compra @relation(fields: [compraId], references: [id])

  // FK compuesta contra (id, compraId) de Tropa: garantiza que la tropa sea de
  // ESTA compra y no de otra. Con tropaId NULL, Postgres no evalúa la
  // restricción (MATCH SIMPLE), así que «todavía no sé la tropa» sigue andando.
  tropaId Int?
  tropa   Tropa? @relation(fields: [tropaId, compraId], references: [id, compraId])

  dte           String?
  transportista String?
  patente       String?
  fechaSalida   DateTime? @db.Date
  destino       String?
  flete         Decimal?  @db.Decimal(14, 2)

  // Cuántos animales declara el DTE que se mueven en este camión. Es un hecho
  // capturado del documento, no un total derivado: los Lote cuelgan de Compra
  // (con tropaId opcional) y nunca de Carga, así que esta cantidad no se puede
  // reconstruir sumando lotes. Nullable porque el DTE es uno de los dos
  // agujeros grandes de cobertura junto con el flete.
  cabezas Int?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("carga")
}

enum ModalidadPrecio {
  KG
  CABEZA
  BULTO
}

enum ModalidadComision {
  PORCENTAJE
  MONTO
}

// tropaId NULLABLE y opcional a propósito: el lote siempre cuelga de la
// compra (compraId NOT NULL); tropaId es una atribución opcional para cuando
// hace falta saber a qué empresa/tropa corresponden esas cabezas dentro de
// una compra con reparto.
model Lote {
  id       Int    @id @default(autoincrement())
  compraId Int
  compra   Compra @relation(fields: [compraId], references: [id])

  // FK compuesta contra (id, compraId) de Tropa: garantiza que la tropa sea de
  // ESTA compra y no de otra. Con tropaId NULL, Postgres no evalúa la
  // restricción (MATCH SIMPLE), así que la atribución sigue siendo opcional.
  tropaId Int?
  tropa   Tropa? @relation(fields: [tropaId, compraId], references: [id, compraId])

  categoriaSinonimoId Int
  categoriaSinonimo   CategoriaSinonimo @relation(fields: [categoriaSinonimoId], references: [id])

  // Única columna de cantidad NOT NULL del esquema. En 2401 renglones
  // históricos de liquidaciones_detalleliquidacion, 0 tienen cantidad_cabezas
  // NULL y 0 tienen categoria_id NULL: categoría+cabezas es el par que siempre
  // estuvo presente. Un lote existe para declarar una cantidad de cabezas de
  // una categoría; sin cabezas la fila no tiene razón de ser.
  // Pendiente para cuando se genere la migración: agregar a mano un
  // CHECK (cabezas > 0). Hay exactamente 1 fila histórica con 0 cabezas y es un
  // error de carga, no un hecho de negocio.
  cabezas Int

  // Peso, no dinero: se queda en Decimal(10, 2).
  kilosOrigen Decimal? @db.Decimal(10, 2)

  precio          Decimal?         @db.Decimal(14, 2)
  modalidadPrecio ModalidadPrecio?

  // La comisión se pacta y se aplica POR RENGLÓN, no por compra. Medido sobre
  // el último año: en la mayoría de las compras multi-renglón el porcentaje es
  // el mismo en todos, pero en varias difiere de verdad (5946: 3 % y 4 %;
  // 6314 y 6321: 2 % y 3 %) y sigue al destino del lote — feedlot 2 %, campo
  // 3 %. Guardarla en la compra hacía imposible representar esos casos.
  //
  // NO EXISTE, NI DEBE EXISTIR, UNA COLUMNA DE COMISIÓN TOTAL EN `Compra`.
  // El total de comisión de una compra se CALCULA sumando el de sus lotes.
  // Guardarlo sería un total almacenado, que es lo que prohíbe la regla 2 («un
  // concepto, un lugar»). El esquema viejo lo hacía —
  // `liquidaciones_liquidacion.comision` es literalmente la suma de sus
  // renglones: la compra 5325 guarda 5.168.904, que es exactamente
  // 2.275.896 + 1.443.256 + 1.286.600 + 163.152 — y era una de las columnas
  // derivadas que le criticamos. No repetirlo por comodidad.
  //
  // Nullable: en el momento del módulo 2 la comisión puede no estar acordada
  // todavía; se conoce al liquidar (módulo 3). Y hay renglones legítimos con
  // comisión cero (compras 5721 y 6299), que es un valor, no un faltante.
  comision          Decimal?           @db.Decimal(14, 2)
  // Acompaña a `comision`: si el monto es s/d, la modalidad también puede serlo.
  comisionModalidad ModalidadComision?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("lote")
}

enum TipoAdjunto {
  REMITO_FERIA // remitos de feria del módulo 2 (número + foto)
  ORIGEN_TERCERO // DECIDIR #6: original del consignatario, sin parsear
  IMPRIMIBLE // DECIDIR #5: la A4 completada a mano, si vuelve por foto
}

// Generalizado en vez de una tabla RemitoFeria + una columna suelta por cada
// tipo de documento nuevo que aparezca (regla: un concepto, un lugar).
model Adjunto {
  id       Int    @id @default(autoincrement())
  compraId Int
  compra   Compra @relation(fields: [compraId], references: [id])

  tipo   TipoAdjunto
  url    String
  numero String? // aplica solo a REMITO_FERIA

  creadoEn DateTime @default(now())

  @@map("adjunto")
}
